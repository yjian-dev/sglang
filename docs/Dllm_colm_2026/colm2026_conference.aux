\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Bottleneck analysis.} Key gaps between DLLMs and AR models: (a)\nobreakspace  {}AR serving infrastructure does not support diffusion-style denoising efficiently; (b)\nobreakspace  {}DLLM parallel decoding consumes far more compute per token, collapsing throughput under concurrency; (c)\nobreakspace  {}mismatched attention patterns between prefill and decoding degrade DLLM accuracy.\relax }}{4}{figure.caption.6}\protected@file@percent }
\newlabel{fig:bottlenecks}{{1}{4}{\textbf {Bottleneck analysis.} Key gaps between DLLMs and AR models: (a)~AR serving infrastructure does not support diffusion-style denoising efficiently; (b)~DLLM parallel decoding consumes far more compute per token, collapsing throughput under concurrency; (c)~mismatched attention patterns between prefill and decoding degrade DLLM accuracy.\relax }{figure.caption.6}{}}
