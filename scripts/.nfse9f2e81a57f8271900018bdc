#!/bin/bash
# Concurrent traffic benchmark: 7 methods on 7 GPUs, 4 datasets each
# Uses tore-speed-eval --traffic_pattern concurrent --levels 1,2,4,8,16,32,64
set -euo pipefail

export PATH=/home/yjian/miniconda3/envs/sglang/bin:/home/yjian/miniconda3/envs/dflash/bin:/usr/local/cuda-12.9/bin:$PATH
export CUDA_HOME=/usr/local/cuda-12.9
export SGLANG_PYTHON=/home/yjian/miniconda3/envs/sglang/bin/python
export DFLASH_PYTHON=/home/yjian/miniconda3/envs/dflash/bin/python
export TORE=/home/yjian/miniconda3/envs/sglang/bin/tore-speed-eval

TIMESTAMP=$(date +%Y%m%d_%H%M%S)
OUT="concurrent_bench_${TIMESTAMP}"
mkdir -p "$OUT"
echo "$OUT" > /tmp/concurrent_out.txt

CONT="/data/cxu/keep/dllm_experiments/sdar_qwen3_8b_dreamshift_ar_b3-causal-from-b2amc_fixed2_cont"
BASE_LORA="/data/cxu/dllm-distillation/training/model/Qwen3-8B-b3-allmasked-causal"
LORA="/data/cxu/keep/dllm_experiments/sdar_qwen3_8b_dreamshift_ar_b3-causal-from-b2amc-lora128_fixed2_epoch2"
EAGLE3="Tengyunw/qwen3_8b_eagle3"

# Methods: name:gpu:port:python:launch_args
# Using max_running_requests=72 for all (enough for concurrent=64)
declare -A METHODS
METHODS=(
    ["ar"]="0:40001:sglang:--model-path Qwen/Qwen3-8B --tp-size 1 --dtype bfloat16 --mem-fraction-static 0.85 --max-running-requests 72"
    ["dflash_s1d16"]="1:40002:dflash:--model-path Qwen/Qwen3-8B --speculative-algorithm DFLASH --speculative-draft-model-path z-lab/Qwen3-8B-DFlash-b16 --speculative-num-steps 1 --speculative-eagle-topk 1 --speculative-num-draft-tokens 16 --tp-size 1 --dtype bfloat16 --attention-backend fa3 --mem-fraction-static 0.85 --max-running-requests 72 --trust-remote-code"
    ["dflash_s1d4"]="2:40003:dflash:--model-path Qwen/Qwen3-8B --speculative-algorithm DFLASH --speculative-draft-model-path z-lab/Qwen3-8B-DFlash-b16 --speculative-num-steps 1 --speculative-eagle-topk 1 --speculative-num-draft-tokens 4 --tp-size 1 --dtype bfloat16 --attention-backend fa3 --mem-fraction-static 0.85 --max-running-requests 72 --trust-remote-code"
    ["eagle3"]="3:40004:dflash:--model-path Qwen/Qwen3-8B --speculative-algorithm EAGLE3 --speculative-draft-model-path $EAGLE3 --speculative-num-steps 3 --speculative-eagle-topk 1 --speculative-num-draft-tokens 4 --tp-size 1 --dtype bfloat16 --mem-fraction-static 0.85 --max-running-requests 72 --trust-remote-code"
    ["ours_n3"]="4:40005:sglang:--model-path $CONT --trust-remote-code --tp-size 1 --dtype bfloat16 --mem-fraction-static 0.85 --max-running-requests 72 --attention-backend flashinfer --dllm-algorithm DreamShiftBlockN --dllm-algorithm-config dreamshift_blockN3_config.yaml"
    ["ours_n4"]="5:40006:sglang:--model-path $CONT --trust-remote-code --tp-size 1 --dtype bfloat16 --mem-fraction-static 0.85 --max-running-requests 72 --attention-backend flashinfer --dllm-algorithm DreamShiftBlockN --dllm-algorithm-config dreamshift_blockN4_config.yaml"
    ["ours_lora"]="6:40007:sglang:--model-path $BASE_LORA --trust-remote-code --tp-size 1 --dtype bfloat16 --mem-fraction-static 0.85 --max-running-requests 72 --attention-backend flashinfer --dllm-algorithm DreamShiftBlockN --dllm-algorithm-config dreamshift_blockN3_config.yaml --enable-lora --lora-paths b3lora=$LORA --max-lora-rank 128"
)

METHOD_ORDER=(ar dflash_s1d16 dflash_s1d4 eagle3 ours_n3 ours_n4 ours_lora)

echo "=============================================="
echo "Concurrent Traffic Benchmark"
echo "Methods: ${METHOD_ORDER[*]}"
echo "Output: $OUT/"
echo "=============================================="

# ── Phase 1: Launch all 7 servers ──
echo ""
echo ">>> Phase 1: Launching servers..."

# Launch AR first (JIT cache for sglang)
method="ar"
IFS=: read gpu port pyenv args <<< "${METHODS[$method]}"
PYTHON_BIN=$SGLANG_PYTHON
echo "  [$method] GPU=$gpu port=$port"
CUDA_VISIBLE_DEVICES=$gpu $PYTHON_BIN -m sglang.launch_server $args --port $port \
    > "$OUT/server_${method}.log" 2>&1 &
for i in $(seq 1 200); do curl -s -o /dev/null -w "%{http_code}" "http://localhost:$port/health" 2>/dev/null | grep -q "200" && echo "  [$method] READY" && break; sleep 3; done

# Launch rest
for method in dflash_s1d16 dflash_s1d4 eagle3 ours_n3 ours_n4 ours_lora; do
    IFS=: read gpu port pyenv args <<< "${METHODS[$method]}"
    if [ "$pyenv" = "dflash" ]; then
        PYTHON_BIN=$DFLASH_PYTHON
        ENV_PREFIX="SGLANG_ENABLE_SPEC_V2=1 SGLANG_ENABLE_DFLASH_SPEC_V2=1 SGLANG_ENABLE_OVERLAP_PLAN_STREAM=1"
    else
        PYTHON_BIN=$SGLANG_PYTHON
        ENV_PREFIX=""
    fi
    echo "  [$method] GPU=$gpu port=$port"
    eval "CUDA_VISIBLE_DEVICES=$gpu $ENV_PREFIX $PYTHON_BIN -m sglang.launch_server $args --port $port" \
        > "$OUT/server_${method}.log" 2>&1 &
done

echo ">>> Waiting for all servers..."
for method in "${METHOD_ORDER[@]}"; do
    IFS=: read gpu port pyenv args <<< "${METHODS[$method]}"
    for j in $(seq 1 200); do
        curl -s -o /dev/null -w "%{http_code}" "http://localhost:$port/health" 2>/dev/null | grep -q "200" && echo "  [$method:$port] OK" && break
        sleep 3
    done
done

# ── Phase 2: Run benchmarks ──
echo ""
echo ">>> Phase 2: Running concurrent benchmarks..."

LEVELS="1,2,4,8,16,32,64"

for ds in aime math500 sharegpt synthetic; do
    echo ""
    echo "=== Dataset: $ds ==="

    if [ "$ds" = "synthetic" ]; then
        ds_args="--dataset_type synthetic --synthetic_input_length 256 --synthetic_output_length 2048 --ignore_eos True"
        n=500
    elif [ "$ds" = "aime" ]; then
        ds_args="--dataset_type jsonl --jsonl_input_path /tmp/aime2224.jsonl --jsonl_dataset_column_name prompt --jsonl_convert_to_chat_request_format true"
        n=90
    elif [ "$ds" = "math500" ]; then
        ds_args="--dataset_type jsonl --jsonl_input_path /tmp/math500.jsonl --jsonl_dataset_column_name prompt --jsonl_convert_to_chat_request_format true"
        n=500
    else
        ds_args="--dataset_type jsonl --jsonl_input_path /tmp/sharegpt.jsonl --jsonl_dataset_column_name prompt --jsonl_convert_to_chat_request_format true"
        n=200
    fi

    for method in "${METHOD_ORDER[@]}"; do
        IFS=: read gpu port pyenv args <<< "${METHODS[$method]}"
        model_name="Qwen/Qwen3-8B"
        lora_args=""
        if [ "$method" = "ours_n3" ] || [ "$method" = "ours_n4" ]; then
            model_name="test"
        elif [ "$method" = "ours_lora" ]; then
            model_name="test"
            lora_args="--lora_names b3lora --lora_ratio 1.0"
        fi

        (
            $TORE --provider sglang --base_url "http://localhost:$port/v1" \
                --model_name "$model_name" --tokenizer_name "Qwen/Qwen3-8B" \
                $ds_args --num_examples $n --max_tokens 2048 \
                --traffic_pattern concurrent --levels $LEVELS \
                --chat True --stream True --temperature 1.0 --top_p 0.95 \
                $lora_args \
                --evaluation_output_path "$OUT/tore_${ds}_${method}.csv" \
                2>&1 > "$OUT/tore_${ds}_${method}.log"
            echo "  [$method] $ds done"
        ) &
    done
    wait
    echo "$ds all methods done."
done

# ── Phase 3: Results ──
echo ""
echo "=============================================="
echo ">>> Results"
echo "=============================================="

$SGLANG_PYTHON -c "
import csv, os, sys

out = '$OUT'
methods = ['ar', 'dflash_s1d16', 'dflash_s1d4', 'eagle3', 'ours_n3', 'ours_n4', 'ours_lora']
datasets = ['aime', 'math500', 'sharegpt', 'synthetic']

for ds in datasets:
    print(f'\n--- {ds} (Job TPS) ---')
    header = f\"{'level':>6}\"
    for m in methods:
        header += f' {m:>14}'
    print(header)

    # Each CSV has one row per level
    data = {}
    for m in methods:
        f = os.path.join(out, f'tore_{ds}_{m}.csv')
        if os.path.exists(f):
            with open(f) as fh:
                for row in csv.DictReader(fh):
                    level = int(float(row.get('traffic_level', 0)))
                    tps = float(row.get('summary_job_level_tps', 0))
                    if level not in data:
                        data[level] = {}
                    data[level][m] = tps

    for level in sorted(data.keys()):
        line = f'{level:>6}'
        for m in methods:
            v = data[level].get(m, 0)
            line += f' {v:>14.1f}'
        print(line)
"

echo ""
echo "All results in $OUT/"
